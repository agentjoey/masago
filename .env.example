# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# Database
# DATABASE_URL: 运行时连接（Neon，需 SSL；连接串 sslmode 不保证被 pg 解析，应用内显式启用 ssl）
# DATABASE_URL_DIRECT: 迁移与 pg_dump 使用的 direct connection（不走 PgBouncer）
DATABASE_URL=
DATABASE_URL_DIRECT=
# 连接池参数见 architecture.md §7.4：小池 + 短 idle，空闲时必须真正断开以允许 Neon 休眠
DB_POOL_MAX=2
DB_POOL_IDLE_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_CONTEXT_TURNS=12
LLM_PROMPT_CACHE_ENABLED=true

# STT
STT_PROVIDER=openai
STT_MODEL=gpt-transcribe
STT_CONTEXT_HINTS_ENABLED=false
OPENAI_API_KEY=

# Audio
AUDIO_TARGET_CONTAINER=webm
AUDIO_REMUX_COPY_CODEC=true
AUDIO_MAX_DURATION_SECONDS=120
AUDIO_MAX_SIZE_MB=20

# TTS
TTS_PROVIDER=minimax
TTS_MODEL_CONVERSATION=speech-2.8-turbo
TTS_MODEL_TEACHING=speech-2.8-hd
TTS_MAX_CHARACTERS=400
# MINIMAX_API_KEY 可留空：未设置时回退到 LLM_API_KEY（MiniMax Token Plan 同一把密钥）
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=Japanese_CalmLady

# Correction rhythm
SURFACE_AFTER_TURNS_CONVERSATION=4
SURFACE_AFTER_TURNS_COACH=1
SURFACE_MAX_ITEMS=3
SURFACE_HIGH_IMPORTANCE_THRESHOLD=2

# 五十音课程
KANA_AUDIO_DIR=assets/kana-audio
KANA_OPTION_COUNT=4
KANA_NEW_PER_DAY=5
KANA_MAX_REVIEWS=20
# 待复习超过这个数就暂停发新假名，先追平
KANA_BACKLOG_THRESHOLD=20

# Review scheduling (FSRS)
# 目标保持率：复习时点希望还能记住的概率。调高则复习更密。
FSRS_REQUEST_RETENTION=0.9

# Session & scheduling
USER_TIMEZONE=Asia/Singapore
SESSION_IDLE_MINUTES=30
DAILY_REMINDER_LOCAL_TIME=20:30
NIGHTLY_BACKUP_LOCAL_TIME=03:00

# Budget & logging
DAILY_COST_SOFT_LIMIT_USD=
MONTHLY_COST_SOFT_LIMIT_USD=
LOG_LEVEL=info
