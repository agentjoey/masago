{
  "name": "masago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:sim": "sh scripts/ci-sim.sh",
    "verify:llm": "tsx --env-file=.env scripts/verify-llm.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:vocab": "tsx scripts/build-jlpt-vocab.ts",
    "build:kana-audio": "tsx --env-file=.env scripts/build-kana-audio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
